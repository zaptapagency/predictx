# Database
DATABASE_URL=postgresql://universalpredict:password@postgres:5432/universalpredict

# Redis
REDIS_URL=redis://redis:6379

# JWT & Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AWS S3 (Optional - for model storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=universalpredict-models
AWS_REGION=us-east-1

# LightGBM Models Path
LIGHTGBM_REPO_PATH=/app/lightgbm-repo
LIGHTGBM_REPO_URL=https://github.com/yourusername/your-lightgbm-repo.git
LIGHTGBM_REPO_BRANCH=main

# API Configuration
API_TITLE=UniversalPredict API
API_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Email (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Stripe (Optional - for billing)
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Google OAuth (Optional)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Sentry (Optional - error tracking)
SENTRY_DSN=

# Environment
ENVIRONMENT=development
